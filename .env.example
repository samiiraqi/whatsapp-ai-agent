# Server
PORT=3000

# WhatsApp webhook (placeholders only)
WHATSAPP_APP_SECRET=changeme
WHATSAPP_VERIFY_TOKEN=changeme

# AI brain: "mock" (default, no network calls) or "claude" (real Claude
# replies). BRAIN=claude only takes effect when ANTHROPIC_API_KEY is also
# set - otherwise MockBrain is used regardless of this value.
BRAIN=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Hard cap on Claude API calls per day, to bound cost. Once reached,
# ClaudeBrain stops calling the API and falls back to a handoff reply.
AI_DAILY_CAP=200

# Dev-only debug endpoint (GET /dev/outbox on app/server). Localhost only.
# Never set this to true outside local development.
DEV_SIMULATOR=false

# Simulator (app/simulator)
SIMULATOR_PORT=4000
APP_SERVER_URL=http://127.0.0.1:3000

# Dashboard (app/dashboard) - also proxies /dev to APP_SERVER_URL above
DASHBOARD_PORT=5173
